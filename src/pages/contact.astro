---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "联系我们：机场资料纠错与合作 - Clash测评家";
const pageDesc = "提交机场最新套餐价格变更、节点失效纠错或商务合作联系。直连电子邮箱 muguang_kelvin1@proton.me。";

const breadcrumbs = [{ label: '联系我们' }];
const targetEmail = "muguang_kelvin1@proton.me";
---

<BaseLayout title={pageTitle} description={pageDesc} breadcrumbs={breadcrumbs}>
  <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="text-center mb-8">
      <h1 class="text-2xl sm:text-3xl font-extrabold text-white mb-3">联系我们：资料纠错与合作</h1>
      <p class="text-xs sm:text-sm text-slate-400 max-w-lg mx-auto">
        如发现本站记录的机场价格、套餐流量或优惠码有误，欢迎向编辑部提交纠错反馈。留言将直接推送至编辑部邮箱。
      </p>
    </div>

    <!-- Direct Email Badge Card -->
    <div class="mb-6 p-4 rounded-2xl bg-slate-900/90 border border-slate-800 flex items-center justify-between shadow-lg">
      <div class="flex items-center space-x-3">
        <div class="w-10 h-10 rounded-xl bg-brand-500/10 border border-brand-500/30 flex items-center justify-center text-brand-400">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 002-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </div>
        <div>
          <span class="text-xs text-slate-400 block font-medium">直连接收电子邮箱</span>
          <a href={`mailto:${targetEmail}`} class="text-sm sm:text-base font-mono font-bold text-brand-300 hover:underline">
            {targetEmail}
          </a>
        </div>
      </div>
      <a
        href={`mailto:${targetEmail}`}
        class="px-3 py-1.5 rounded-lg text-xs font-semibold text-white bg-slate-800 hover:bg-slate-700 border border-slate-700 transition-colors"
      >
        直接发邮件
      </a>
    </div>

    <!-- Contact Form Card -->
    <div class="glass-card p-6 rounded-2xl border border-slate-800 relative">
      <form
        id="contact-form"
        action={`https://formsubmit.co/${targetEmail}`}
        method="POST"
        class="space-y-4"
      >
        <!-- FormSubmit Control Options -->
        <input type="hidden" name="_subject" value="[Clash测评家] 网站新的资料纠错与留言反馈" />
        <input type="hidden" name="_captcha" value="false" />
        <input type="hidden" name="_template" value="table" />
        <input type="text" name="_honey" class="hidden" style="display:none" />

        <div>
          <label for="contact-email" class="block text-xs font-bold text-slate-300 mb-1.5">
            您的称呼 / 邮箱 <span class="text-brand-400">*</span>
          </label>
          <input
            type="text"
            id="contact-email"
            name="sender_info"
            required
            class="w-full px-3.5 py-2.5 rounded-xl bg-slate-900 border border-slate-700/80 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500 transition-all"
            placeholder="your@email.com"
          />
        </div>

        <div>
          <label for="contact-type" class="block text-xs font-bold text-slate-300 mb-1.5">
            反馈类型
          </label>
          <select
            id="contact-type"
            name="feedback_type"
            class="w-full px-3.5 py-2.5 rounded-xl bg-slate-900 border border-slate-700/80 text-sm text-white focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500 transition-all"
          >
            <option value="机场资料与价格纠错">机场资料与价格纠错</option>
            <option value="节点失效/域名变更提交">节点失效/域名变更提交</option>
            <option value="商务合作洽谈">商务合作洽谈</option>
            <option value="其他使用疑问">其他使用疑问</option>
          </select>
        </div>

        <div>
          <label for="contact-message" class="block text-xs font-bold text-slate-300 mb-1.5">
            详细描述 <span class="text-brand-400">*</span>
          </label>
          <textarea
            id="contact-message"
            name="message"
            rows="4"
            required
            class="w-full px-3.5 py-2.5 rounded-xl bg-slate-900 border border-slate-700/80 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500 transition-all leading-relaxed"
            placeholder="请填写纠错详情与正确参考界面..."
          ></textarea>
        </div>

        <!-- Submit Button -->
        <button
          type="submit"
          id="submit-btn"
          class="w-full py-3 rounded-xl bg-gradient-to-r from-brand-600 to-brand-500 hover:from-brand-500 hover:to-brand-400 font-bold text-white text-sm shadow-lg shadow-brand-600/20 transition-all hover:scale-[1.01] flex items-center justify-center space-x-2"
        >
          <span id="btn-text">提交反馈信息</span>
          <svg id="btn-spinner" class="w-4 h-4 text-white animate-spin hidden" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
        </button>

        <!-- Status Toast Banner -->
        <div id="form-status" class="hidden p-4 rounded-xl text-xs sm:text-sm font-semibold text-center border"></div>
      </form>
    </div>
  </div>
</BaseLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('submit-btn');
  const btnText = document.getElementById('btn-text');
  const btnSpinner = document.getElementById('btn-spinner');
  const formStatus = document.getElementById('form-status');
  const targetEmail = "muguang_kelvin1@proton.me";

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      if (!btnText || !btnSpinner || !submitBtn || !formStatus) return;

      btnText.textContent = '正在提交...';
      btnSpinner.classList.remove('hidden');
      (submitBtn as HTMLButtonElement).disabled = true;
      formStatus.classList.add('hidden');

      const formData = new FormData(form);

      try {
        const response = await fetch(`https://formsubmit.co/ajax/${targetEmail}`, {
          method: 'POST',
          body: formData,
          headers: {
            'Accept': 'application/json'
          }
        });

        if (response.ok) {
          formStatus.className = 'p-4 rounded-xl text-xs sm:text-sm font-semibold text-center bg-emerald-500/10 border-emerald-500/30 text-emerald-300 border';
          formStatus.innerHTML = `✅ 反馈信息已成功提交！留言已实时推送至 <strong>${targetEmail}</strong>。感谢您的支持！`;
          formStatus.classList.remove('hidden');
          form.reset();
        } else {
          // Fallback native submit
          form.submit();
        }
      } catch (err) {
        console.warn('AJAX submit error, falling back to native submit:', err);
        // Fallback native submit
        form.submit();
      } finally {
        btnText.textContent = '提交反馈信息';
        btnSpinner.classList.add('hidden');
        (submitBtn as HTMLButtonElement).disabled = false;
      }
    });
  }
</script>
