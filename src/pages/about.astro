---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "个人中心 | Clash测评家 · 站长与项目档案";
const pageDesc = "了解Clash测评家的创立初衷、多维度测速标准、内容更新准则与勘误反馈机制。客观实测，拒绝虚标，晚高峰见真章。";

const breadcrumbs = [{ label: '个人中心' }];
---

<BaseLayout title={pageTitle} description={pageDesc} breadcrumbs={breadcrumbs}>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-10">
    
    <!-- Hero Header -->
    <header class="text-center space-y-4 max-w-3xl mx-auto">
      <div class="inline-flex items-center space-x-2 px-3.5 py-1.5 rounded-full bg-brand-500/10 border border-brand-500/30 text-brand-300 text-xs font-semibold">
        <span>⚡ 站长与项目档案</span>
        <span>•</span>
        <span>个人中心</span>
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight">
        Clash测评家 · 个人中心
      </h1>

      <div class="p-4 sm:p-6 rounded-2xl bg-gradient-to-r from-slate-900/90 via-slate-900/95 to-slate-900/90 border border-brand-500/30 shadow-xl text-center space-y-2">
        <p class="text-lg sm:text-xl font-bold text-brand-400">
          ⚡ 客观实测 · 拒绝虚标 · 晚高峰见真章
        </p>
        <p class="text-xs sm:text-sm text-slate-300 leading-relaxed max-w-2xl mx-auto">
          这里是专注于网络加速线路深度压测、协议原理解析与防失联指南的独立测评空间。还原真相，降低试错。
        </p>
      </div>
    </header>

    <!-- Section 1: 我们需要传达什么信息？ -->
    <section class="space-y-4">
      <div class="flex items-center space-x-2 border-b border-slate-800 pb-3">
        <span class="text-xl">🧭</span>
        <h2 class="text-xl sm:text-2xl font-bold text-white">我们需要传达什么信息？</h2>
      </div>

      <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
        在节点推广与营销信息极度泛滥的环境下，普通用户往往面临 <strong class="text-amber-300">“买前千兆跑满，买后晚高峰转圈”</strong>、<strong class="text-amber-300">“宣传全专线，实测高丢包”</strong> 的困境。<strong>Clash测评家</strong> 的核心宗旨只有八个字：<strong>还原真相，降低试错</strong>。
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2">
        <div class="p-5 rounded-2xl bg-slate-950/80 border border-slate-800 hover:border-brand-500/40 transition-all space-y-2">
          <div class="w-10 h-10 rounded-xl bg-brand-500/10 border border-brand-500/30 flex items-center justify-center text-xl">
            🛡️
          </div>
          <h3 class="text-base font-bold text-white">1. 去泡沫化的真实表现</h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            不看商家的宣传文案，只看抓包与链路压测的客观数据。用毫秒级延时与实际丢包率说话。
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-slate-950/80 border border-slate-800 hover:border-brand-500/40 transition-all space-y-2">
          <div class="w-10 h-10 rounded-xl bg-brand-500/10 border border-brand-500/30 flex items-center justify-center text-xl">
            🎯
          </div>
          <h3 class="text-base font-bold text-white">2. 场景化精确匹配</h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            明确区分轻量办公、外贸跨境、4K/8K 流媒体、跨国低延迟游戏等不同需求，不盲目推贵，只推最适合。
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-slate-950/80 border border-slate-800 hover:border-brand-500/40 transition-all space-y-2">
          <div class="w-10 h-10 rounded-xl bg-brand-500/10 border border-brand-500/30 flex items-center justify-center text-xl">
            📡
          </div>
          <h3 class="text-base font-bold text-white">3. 长期可用性预警</h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            关注线路服务商的冗余架构与运营健康度，及时发出拥堵与风险提示，保障用户投资安全。
          </p>
        </div>
      </div>
    </section>

    <!-- Section 2: 我们是谁？创建本站的目的 -->
    <section class="space-y-4">
      <div class="flex items-center space-x-2 border-b border-slate-800 pb-3">
        <span class="text-xl">👥</span>
        <h2 class="text-xl sm:text-2xl font-bold text-white">我们是谁？创建这个网站的目的是什么？</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Card Left: 我们是谁 -->
        <div class="p-6 rounded-2xl bg-slate-900/80 border border-slate-800 space-y-3">
          <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-lg bg-brand-500/10 border border-brand-500/30 text-brand-300 text-xs font-bold">
            👤 身份说明
          </div>
          <h3 class="text-lg font-bold text-white">1. 我们是谁？</h3>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
            我们是一群长期深耕网络代理协议、开源网络工具（Clash / Sing-box 等）及网络架构实测的技术爱好者与独立评测人。既不是某单一商家的利益附属，也不是盲目搬运测速图的聚合机器人。
          </p>
        </div>

        <!-- Card Right: 创建目的 -->
        <div class="p-6 rounded-2xl bg-slate-900/80 border border-slate-800 space-y-3">
          <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-lg bg-brand-500/10 border border-brand-500/30 text-brand-300 text-xs font-bold">
            🎯 核心目的
          </div>
          <h3 class="text-lg font-bold text-white">2. 创建本站的目的</h3>
          <ul class="space-y-2 text-xs sm:text-sm text-slate-300">
            <li class="flex items-start space-x-2">
              <span class="text-brand-400 font-bold">•</span>
              <span><strong>打破信息不对称</strong>：让人看清背后的技术成本（BGP中继 / IPLC/IEPL 专线）与线路差异，少花冤枉钱。</span>
            </li>
            <li class="flex items-start space-x-2">
              <span class="text-brand-400 font-bold">•</span>
              <span><strong>建立标准化参考系</strong>：通过统一的环境与固定时间窗口测试，给关注网络质量的读者提供横向对比参考。</span>
            </li>
            <li class="flex items-start space-x-2">
              <span class="text-brand-400 font-bold">•</span>
              <span><strong>沉淀工具与配置技巧</strong>：系统整理主流客户端配置教程、分流规则优化与故障排查方案。</span>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Section 3: 测评标准与方法论表格 -->
    <section class="space-y-4">
      <div class="flex items-center space-x-2 border-b border-slate-800 pb-3">
        <span class="text-xl">🔬</span>
        <h2 class="text-xl sm:text-2xl font-bold text-white">我们要怎么测评？（测评标准与方法）</h2>
      </div>

      <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
        为了保证每一项评测数据的严谨与可复现性，我们遵循以下四维评估体系：
      </p>

      <div class="overflow-x-auto rounded-2xl border border-slate-800 shadow-xl">
        <table class="w-full text-left text-xs sm:text-sm border-collapse">
          <thead>
            <tr class="bg-slate-900 border-b border-slate-800 text-slate-200">
              <th class="py-3.5 px-4 font-bold w-1/4">评估维度</th>
              <th class="py-3.5 px-4 font-bold w-5/12">测试方法与重点指标</th>
              <th class="py-3.5 px-4 font-bold w-1/3">评估目的</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800/80 bg-slate-950/60 text-slate-300">
            <tr class="hover:bg-slate-900/40 transition-colors">
              <td class="py-3.5 px-4 font-bold text-white flex items-center space-x-2">
                <span class="text-brand-400">🌙</span>
                <span>晚高峰压力测试</span>
              </td>
              <td class="py-3.5 px-4 leading-relaxed">
                聚焦每日 <strong class="text-brand-300">20:00 - 23:00</strong> 骨干网拥堵时段，持续进行大文件吞吐与跑分压测。
              </td>
              <td class="py-3.5 px-4 text-slate-400 leading-relaxed">
                检验服务商的带宽冗余与抗拥塞调度能力。
              </td>
            </tr>

            <tr class="hover:bg-slate-900/40 transition-colors">
              <td class="py-3.5 px-4 font-bold text-white flex items-center space-x-2">
                <span class="text-brand-400">📊</span>
                <span>链路稳定性与丢包</span>
              </td>
              <td class="py-3.5 px-4 leading-relaxed">
                针对香港、日本、新加坡、美国等核心节点，进行持续 <strong class="text-brand-300">1,000+ 数据包</strong> 的连续 Ping 与 MTR 追踪。
              </td>
              <td class="py-3.5 px-4 text-slate-400 leading-relaxed">
                暴露假专线、抖动大、断流频繁等隐性缺陷。
              </td>
            </tr>

            <tr class="hover:bg-slate-900/40 transition-colors">
              <td class="py-3.5 px-4 font-bold text-white flex items-center space-x-2">
                <span class="text-brand-400">🎬</span>
                <span>流媒体与解锁能力</span>
              </td>
              <td class="py-3.5 px-4 leading-relaxed">
                定期检测 Netflix、Disney+、YouTube Premium 及主流 AI 平台的原生/DNS 解锁状态与住宅 IP 纯净度。
              </td>
              <td class="py-3.5 px-4 text-slate-400 leading-relaxed">
                满足内容创作者与影音爱好者的刚性需求。
              </td>
            </tr>

            <tr class="hover:bg-slate-900/40 transition-colors">
              <td class="py-3.5 px-4 font-bold text-white flex items-center space-x-2">
                <span class="text-brand-400">💻</span>
                <span>客户端生态兼容</span>
              </td>
              <td class="py-3.5 px-4 leading-relaxed">
                测试在 Clash Verge Rev、Sing-box 等主流核心下的配置下发、规则分流及故障切换表现。
              </td>
              <td class="py-3.5 px-4 text-slate-400 leading-relaxed">
                确保跨平台（Windows / macOS / iOS / Android）开箱即用。
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Section 4: 内容准确性与更正声明 -->
    <section class="space-y-4">
      <div class="flex items-center space-x-2 border-b border-slate-800 pb-3">
        <span class="text-xl">⚖️</span>
        <h2 class="text-xl sm:text-2xl font-bold text-white">内容准确性与更正声明（勘误机制）</h2>
      </div>

      <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
        网络环境受国际海缆状况、上游机房策略、运营商路由调度等多种不可控因素影响，测评数据具有<strong>时效性与阶段性</strong>特征：
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="p-4 rounded-xl bg-slate-900/70 border border-slate-800 space-y-1.5">
          <h4 class="text-sm font-bold text-white">1. 时效性说明</h4>
          <p class="text-xs text-slate-400 leading-relaxed">
            所有评测报告均附带<strong>实测日期与测试节点批次</strong>。过往数据仅代表测试周期的表现，不代表未来永久服务质量。
          </p>
        </div>

        <div class="p-4 rounded-xl bg-slate-900/70 border border-slate-800 space-y-1.5">
          <h4 class="text-sm font-bold text-white">2. 主动复测机制</h4>
          <p class="text-xs text-slate-400 leading-relaxed">
            我们对重点收录的线路进行月度/季度动态复测；若发生大规模网络割接或架构调整，相应评测将标注状态或重新测试。
          </p>
        </div>

        <div class="p-4 rounded-xl bg-slate-900/70 border border-slate-800 space-y-1.5">
          <h4 class="text-sm font-bold text-white">3. 公开勘误与读者反馈</h4>
          <p class="text-xs text-slate-400 leading-relaxed">
            收到勘误信息后，将在 <strong>48 小时内</strong> 安排交叉复验，于文章顶部更新修订日志（Changelog）。
          </p>
        </div>
      </div>
    </section>

    <!-- Section 5: 快捷指引与联络渠道 -->
    <section class="space-y-4 pt-4 border-t border-slate-800">
      <div class="flex items-center space-x-2">
        <span class="text-xl">📌</span>
        <h2 class="text-xl sm:text-2xl font-bold text-white">快捷指引与联络渠道</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <a
          href="/recommendations/"
          class="p-5 rounded-2xl bg-slate-900 border border-slate-800 hover:border-brand-500/50 hover:bg-slate-800/80 transition-all group block space-y-2"
        >
          <div class="text-2xl group-hover:scale-110 transition-transform">🚀</div>
          <h3 class="text-base font-bold text-white group-hover:text-brand-300">实测推荐榜</h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            前往查看最新一期的 28 家机场横向综合实测与分级指南。
          </p>
        </a>

        <a
          href="/guides/"
          class="p-5 rounded-2xl bg-slate-900 border border-slate-800 hover:border-brand-500/50 hover:bg-slate-800/80 transition-all group block space-y-2"
        >
          <div class="text-2xl group-hover:scale-110 transition-transform">🛠️</div>
          <h3 class="text-base font-bold text-white group-hover:text-brand-300">新手配置手册</h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            客户端下载、订阅转换与全平台分流规则进阶优化教程。
          </p>
        </a>

        <a
          href="/contact/"
          class="p-5 rounded-2xl bg-slate-900 border border-slate-800 hover:border-brand-500/50 hover:bg-slate-800/80 transition-all group block space-y-2"
        >
          <div class="text-2xl group-hover:scale-110 transition-transform">📮</div>
          <h3 class="text-base font-bold text-white group-hover:text-brand-300">勘误 / 交流建议</h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            提供测速样本、反馈失效信息或通过留言板直接联络编辑部。
          </p>
        </a>
      </div>
    </section>

  </div>
</BaseLayout>
