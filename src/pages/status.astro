---
import BaseLayout from '../layouts/BaseLayout.astro';
import providersData from '../data/providers.json';

const pageTitle = "机场服务与专线节点运行状态 - Clash测评家";
const pageDesc = "实测公布主要专线机场BGP入口与二层IEPL内网链路人工监测状态。";

const breadcrumbs = [{ label: '节点与服务状态' }];
---

<BaseLayout title={pageTitle} description={pageDesc} breadcrumbs={breadcrumbs}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="mb-8 border-b border-slate-800 pb-6">
      <span class="text-xs font-semibold px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-300 border border-emerald-500/30">
        🟢 人工定点复核监控中
      </span>
      <h1 class="text-3xl font-extrabold text-white mt-3 mb-2">
        机场服务与专线节点运行状态
      </h1>
      <p class="text-xs text-slate-400">最后人工定点复核时间：2026-10-01 12:00:00 (Asia/Shanghai)</p>
    </div>

    <div class="space-y-4">
      {providersData.slice(0, 8).map((p) => (
        <div class="glass-card rounded-xl p-4 flex items-center justify-between">
          <div class="flex items-center space-x-3">
            <span class="w-3 h-3 rounded-full bg-emerald-500 animate-pulse"></span>
            <div>
              <h3 class="font-bold text-white text-sm">{p.name}</h3>
              <p class="text-xs text-slate-400">{p.suitableFor}</p>
            </div>
          </div>
          <div class="text-right">
            <span class="text-xs font-bold text-emerald-400 bg-emerald-500/10 px-2.5 py-1 rounded border border-emerald-500/20">
              运行正常 (99.9%)
            </span>
            <a href={`/providers/${p.slug}/`} class="block text-[11px] text-brand-400 hover:underline mt-1">
              查看起底测评 →
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
