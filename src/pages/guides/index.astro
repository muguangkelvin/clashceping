---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProviderCard from '../../components/ProviderCard.astro';
import FAQ from '../../components/FAQ.astro';
import providersData from '../../data/providers.json';

const pageTitle = "新手教程与客户端配置指南：全平台（Windows/Mac/iOS/Android）保姆级图文教程 - Clash测评家";
const pageDesc = "全网最详细的机场新手入门与客户端配置保姆级教程，全文直接展示 Windows、macOS、iPhone/iPad 及 Android 的订阅导入与 TUN 模式设置指引。";

const breadcrumbs = [{ label: '新手教程中心' }];

const top4Providers = providersData.slice(0, 4);

const faqs = [
  {
    question: "第一次配置 Clash 导入订阅后，提示 Timeout 超时或 Ping 9999ms 怎么处理？",
    answer: "首先请检查订阅链接是否完整复制，然后尝试在客户端中右键点击订阅并选择‘更新 (Update)’；检查本地电脑杀毒软件或防火墙是否拦截了 Clash 进程；在软件设置中尝试更换不同的代理节点。"
  },
  {
    question: "为什么开代理后部分国内网站（如淘宝、微信）打开变慢甚至打不开？",
    answer: "请确认客户端的运行模式选择为‘Rule (规则模式)’而非‘Global (全局模式)’。规则模式会自动识别国内 IP 走本地直连（DIRECT），只有海外网站才走专线加速。"
  }
];

const guidesSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": pageTitle,
  "description": pageDesc,
  "author": {
    "@type": "Organization",
    "name": "Clash测评家"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Clash测评家",
    "url": "https://clashceping.homes"
  }
};
---

<BaseLayout title={pageTitle} description={pageDesc} breadcrumbs={breadcrumbs} schema={guidesSchema}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    
    <!-- Header -->
    <div class="max-w-3xl mb-10">
      <span class="text-xs font-semibold px-3 py-1 rounded-full bg-brand-500/10 text-brand-300 border border-brand-500/30">
        📚 全平台保姆级配置
      </span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white mt-3 mb-4">
        新手教程与全平台客户端配置指南
      </h1>
      <p class="text-sm text-slate-300 leading-relaxed bg-slate-950/60 p-4 rounded-xl border border-slate-800">
        无论你是第一次接触 Clash 的电脑小白，还是想在 iPhone 上配置小火箭 Shadowrocket，本页面全文直接展示所有步骤细节，无需任何点击跳转。
      </p>
    </div>

    <!-- Top 4 Recommended Providers for Beginners -->
    <section class="mb-14">
      <h2 class="text-xl font-bold text-white mb-6">💡 新手首选高稳定度专线机场 (固定前四名)</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {top4Providers.map((provider) => (
          <ProviderCard provider={provider} />
        ))}
      </div>
    </section>

    <!-- 4 Platform Full Inline Tutorials Section (No click/Read-More buttons) -->
    <section class="mb-14 space-y-10 border-t border-slate-800 pt-10">
      <div class="border-b border-slate-800 pb-4">
        <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 text-xs font-bold mb-2">
          📖 全平台保姆级教程 · 全文直接展示
        </div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white">
          📱 4 大平台客户端一键配置图文指南
        </h2>
        <p class="text-xs sm:text-sm text-slate-400 mt-1">
          全文直接展示无须二次点击，涵盖 Windows、macOS、iPhone/iPad 与 Android 的完整步骤。
        </p>
      </div>

      <!-- Platform 1: Windows -->
      <article id="windows" class="glass-card rounded-2xl p-6 sm:p-8 border border-slate-800 space-y-4 scroll-mt-20">
        <div class="inline-block px-2.5 py-0.5 rounded bg-brand-500/20 text-brand-300 text-xs font-bold border border-brand-500/30">
          💻 Windows 平台
        </div>
        <h3 class="text-xl sm:text-2xl font-bold text-white">
          一、 Windows 平台：Clash Verge Rev 保姆级配置教程
        </h3>
        <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
          <strong class="text-white">Clash Verge Rev</strong> 是目前 Windows 10 / 11 平台上体验最好、基于 Mihomo (Clash.Meta) 最新内核的代理软件。
        </p>
        <div class="p-4 bg-slate-950/80 rounded-xl border border-slate-800 text-xs space-y-2">
          <div class="font-bold text-brand-300 mb-1">📋 操作步骤指引：</div>
          <ol class="list-decimal list-inside text-slate-300 space-y-2 pl-1">
            <li><strong>步骤 1：复制机场订阅地址：</strong> 登录支持 Clash 协议的服务商后台（如 <a href="/providers/review-varnexa-lingdong/" class="text-brand-400 font-bold hover:underline">灵动云</a> 或 <a href="/providers/review-flycat-cloud/" class="text-brand-400 font-bold hover:underline">飞猫云</a>），找到订阅面板，点击“复制 Clash 订阅链接”。</li>
            <li><strong>步骤 2：导入配置文件：</strong> 打开 Clash Verge Rev，进入左侧 <code class="text-brand-300 font-mono">订阅 (Profiles)</code> 页面，在顶部的 URL 输入框中粘贴链接，点击 <code class="text-brand-300 font-mono">导入 (Import)</code>。</li>
            <li><strong>步骤 3：开启系统代理与 TUN 模式：</strong> 在设置页面开启 <code class="text-brand-300 font-mono">系统代理 (System Proxy)</code>。如需全盘接管游戏或命令行流量，同时开启 <code class="text-brand-300 font-mono">Tun 模式</code>。</li>
            <li><strong>步骤 4：测试节点连通性：</strong> 进入 <code class="text-brand-300 font-mono">代理 (Proxies)</code> 界面选择 <code class="text-brand-300 font-mono">Rule (规则模式)</code>，点击右上角闪电图标完成延迟测试，选择香港或日本节点即可畅快冲浪。</li>
          </ol>
        </div>
      </article>

      <!-- Platform 2: macOS -->
      <article id="macos" class="glass-card rounded-2xl p-6 sm:p-8 border border-slate-800 space-y-4 scroll-mt-20">
        <div class="inline-block px-2.5 py-0.5 rounded bg-purple-500/20 text-purple-300 text-xs font-bold border border-purple-500/30">
          🍏 macOS 平台
        </div>
        <h3 class="text-xl sm:text-2xl font-bold text-white">
          二、 macOS 苹果电脑：Clash Verge / Sing-box 配置教程
        </h3>
        <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
          针对 M1 / M2 / M3 Apple Silicon 芯片的 Mac 电脑，推荐使用原生编译的 Clash Verge Rev 或 Sing-box，低功耗且性能极高。
        </p>
        <div class="p-4 bg-slate-950/80 rounded-xl border border-slate-800 text-xs space-y-2">
          <div class="font-bold text-purple-300 mb-1">📋 操作步骤指引：</div>
          <ol class="list-decimal list-inside text-slate-300 space-y-2 pl-1">
            <li><strong>步骤 1：下载对应架构软件：</strong> 确认 Mac 的 CPU 类型（Intel 芯片选择 x64，M 芯片选择 aarch64），下载 DMG 文件并拖入 Applications 安装。</li>
            <li><strong>步骤 2：授权辅助功能权限：</strong> 第一次开启 TUN 模式时，macOS 系统会提示授权网络扩展或输入开机密码以允许新建虚拟网卡。</li>
            <li><strong>步骤 3：导入与选择规则：</strong> 粘贴机场 Clash/Sing-box 订阅链接，刷新后在代理分组中选择低延迟东亚节点即可。</li>
          </ol>
        </div>
      </article>

      <!-- Platform 3: iPhone / iPad -->
      <article id="ios" class="glass-card rounded-2xl p-6 sm:p-8 border border-slate-800 space-y-4 scroll-mt-20">
        <div class="inline-block px-2.5 py-0.5 rounded bg-pink-500/20 text-pink-300 text-xs font-bold border border-pink-500/30">
          📱 iPhone / iPad (iOS)
        </div>
        <h3 class="text-xl sm:text-2xl font-bold text-white">
          三、 iPhone / iPad：Shadowrocket (小火箭) 配置教程
        </h3>
        <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
          在 iOS / iPadOS 平台上，<strong class="text-white">Shadowrocket (小火箭)</strong> 是性价比最高、操作最便捷的代理客户端。
        </p>
        <div class="p-4 bg-slate-950/80 rounded-xl border border-slate-800 text-xs space-y-2">
          <div class="font-bold text-pink-300 mb-1">📋 操作步骤指引：</div>
          <ol class="list-decimal list-inside text-slate-300 space-y-2 pl-1">
            <li><strong>步骤 1：准备非中国大陆区 Apple ID：</strong> 在 App Store 切换至美区或港区账号，搜索并下载 Shadowrocket。</li>
            <li><strong>步骤 2：一键添加节点订阅：</strong> 打开手机浏览器登录机场后台，点击“一键导入小火箭”，或在小火箭右上角点击 <code class="text-brand-300 font-mono">+</code> 号，选择类型为 <code class="text-brand-300 font-mono">Subscribe</code> 并粘贴 URL。</li>
            <li><strong>步骤 3：允许 VPN 配置与指纹验证：</strong> 第一次滑动顶部的“未连接”开关时，系统会弹出授权添加 VPN 配置提示，验证 Touch ID / Face ID 即可完成开启。</li>
          </ol>
        </div>
      </article>

      <!-- Platform 4: Android -->
      <article id="android" class="glass-card rounded-2xl p-6 sm:p-8 border border-slate-800 space-y-4 scroll-mt-20">
        <div class="inline-block px-2.5 py-0.5 rounded bg-orange-500/20 text-orange-300 text-xs font-bold border border-orange-500/30">
          🤖 Android 平台
        </div>
        <h3 class="text-xl sm:text-2xl font-bold text-white">
          四、 Android 安卓手机：Surfboard (冲浪板) 配置教程
        </h3>
        <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
          在安卓平台上，<strong class="text-white">Surfboard (冲浪板)</strong> 采用了符合 Android 规范的 Material You 设计语言，兼容主流 Clash 属性。
        </p>
        <div class="p-4 bg-slate-950/80 rounded-xl border border-slate-800 text-xs space-y-2">
          <div class="font-bold text-orange-300 mb-1">📋 操作步骤指引：</div>
          <ol class="list-decimal list-inside text-slate-300 space-y-2 pl-1">
            <li><strong>步骤 1：安装 APK 并导入配置：</strong> 下载 Surfboard 安装包，打开软件后进入底部 <code class="text-brand-300 font-mono">配置</code> 选项卡，点击右下角加号选择 <code class="text-brand-300 font-mono">从 URL 导入</code>。</li>
            <li><strong>步骤 2：开启代理并应用分流：</strong> 在 <code class="text-brand-300 font-mono">仪表盘</code> 中开启代理开关，出站选择 <code class="text-brand-300 font-mono">规则分流</code>，即可兼顾国内 App 直连与海外流量加速。</li>
          </ol>
        </div>
      </article>

    </section>

    <!-- FAQ Component -->
    <footer class="mt-12 pt-8 border-t border-slate-800">
      <h2 class="text-xl font-bold text-white mb-4">❓ 新手常见疑问解答</h2>
      <FAQ items={faqs} />
    </footer>

  </div>
</BaseLayout>
