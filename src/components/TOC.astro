---
export interface Heading {
  depth: number;
  slug: string;
  text: string;
}

const { headings = [] } = Astro.props as { headings: Heading[] };

const filteredHeadings = headings.filter(h => h.depth >= 2 && h.depth <= 3);
---

{filteredHeadings.length > 0 && (
  <nav aria-label="文章目录" class="my-6 p-4 rounded-xl bg-slate-950/80 border border-slate-800">
    <div class="text-sm font-bold text-white mb-2.5 flex items-center gap-2">
      <span>📑</span>
      <span>文章目录导览</span>
    </div>
    <ul class="space-y-1.5 text-xs text-slate-300">
      {filteredHeadings.map((h) => (
        <li class={h.depth === 3 ? "pl-4 text-slate-400" : "font-medium"}>
          <a href={`#${h.slug}`} class="hover:text-brand-400 transition-colors block py-0.5">
            {h.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}
