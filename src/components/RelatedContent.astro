---
export interface Article {
  title: string;
  summary: string;
  url: string;
}

const { articles = [] } = Astro.props as { articles: Article[] };
---

{articles.length > 0 && (
  <div class="my-10 p-6 rounded-2xl bg-slate-950/60 border border-slate-800">
    <h3 class="text-base font-bold text-white mb-4 flex items-center gap-2">
      <span>🔗</span>
      <span>延伸阅读与相关推荐</span>
    </h3>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {articles.map((art) => (
        <a href={art.url} class="p-3.5 rounded-xl bg-slate-900 hover:bg-slate-850 border border-slate-800/80 hover:border-brand-500/40 transition-colors group block">
          <h4 class="text-xs font-bold text-slate-200 group-hover:text-brand-300 transition-colors line-clamp-1 mb-1">
            {art.title}
          </h4>
          <p class="text-[11px] text-slate-400 line-clamp-2">
            {art.summary}
          </p>
        </a>
      ))}
    </div>
  </div>
)}
