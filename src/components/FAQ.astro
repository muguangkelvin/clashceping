---
export interface FAQItem {
  question: string;
  answer: string;
}

const { items = [] } = Astro.props as { items: FAQItem[] };
---

<div class="space-y-3 my-6">
  {items.map((faq) => (
    <details class="group p-4 rounded-xl bg-slate-900/60 border border-slate-800 transition-all duration-200">
      <summary class="font-semibold text-slate-100 text-sm cursor-pointer flex items-center justify-between list-none group-open:text-brand-400">
        <span>❓ {faq.question}</span>
        <span class="text-xs text-slate-500 group-open:rotate-180 transition-transform">▼</span>
      </summary>
      <div class="mt-3 pt-3 border-t border-slate-800/60 text-xs text-slate-300 leading-relaxed">
        {faq.answer}
      </div>
    </details>
  ))}
</div>
